# ─────────────────────────────────────────────────────────────────────────────
# AI Interview Coach — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# ── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — use a strong random string, minimum 32 characters
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_EXPIRE=7d

# ── AI Engine ─────────────────────────────────────────────────────────────────
# USE_MOCK_AI=true  → offline heuristic engine (no API key needed)
# USE_MOCK_AI=false → calls OpenAI-compatible API
USE_MOCK_AI=true
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ── Frontend CORS ─────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Legacy MongoDB (only needed for one-time data migration) ──────────────────
# MONGODB_URI=mongodb://localhost:27017/interview_coach
